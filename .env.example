# =============================================================
# Nexora AI Forge — environment variable NAMES (placeholders)
# -------------------------------------------------------------
# These are NAMES ONLY. Copy them into the Netlify dashboard:
#   Site settings → Environment variables → Add a variable
# NEVER put real keys/passwords in this file, in config.js,
# or anywhere in frontend code.
# =============================================================

# --- Email notifications (https://resend.com) ---
# API key from Resend → API Keys. Keep it secret.
RESEND_API_KEY=

# Where notification emails are delivered (your business inbox).
ENQUIRY_TO_EMAIL=

# Sender shown in the inbox, must be on a domain verified in Resend,
# e.g. "Nexora AI Forge <enquiries@yourdomain.com>"
ENQUIRY_FROM_EMAIL=

# --- Lead storage (optional, https://supabase.com) ---
# Run supabase/enquiries.sql in the Supabase SQL editor first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Table name (defaults to "enquiries")
ENQUIRY_TABLE=enquiries

# --- Spam / abuse tuning (optional) ---
# Enquiries allowed per IP per 10 minutes (default 5)
ENQUIRY_RATE_LIMIT=5
# Minimum seconds a form may take to submit (default 3)
ENQUIRY_MIN_SECONDS=3

# --- SEO ---
# Final production URL without a trailing slash, e.g.
# https://your-site.netlify.app  — enables sitemap.xml + canonical tags.
SITE_URL=
